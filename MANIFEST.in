include LICENSE README.md CHANGELOG.md requirements-lock.txt requirements-release-lock.txt
include start.cmd self-test.cmd build-release.cmd
recursive-include docs *.md
recursive-include profiles *.json
exclude profiles/local.json
recursive-include scripts *.py
recursive-include packaging *.py
recursive-include packaging *.terms
recursive-include packaging *.md
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
